{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "lib": ["esnext", "dom", "dom.iterable"],
    "strict": true,
    "jsx": "preserve",
    "allowJs": true,
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "~/components/*": [
        "./src/components/*.vue"
      ],
      "~/store/*": [
        "./src/store/*"
      ],
      "~/models/*": [
        "./src/models/*"
      ],
      "~/plugins/*": [
        "./src/plugins/*"
      ],
      "~/utils/*": [
        "./src/utils/*"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
