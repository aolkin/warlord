{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "lib": ["esnext", "dom", "dom.iterable"],
    "strict": true,
    "jsx": "preserve",
    "allowJs": true,
    "paths": {
      "~/*": [
        "./src/ui/*"
      ],
      "~/components/*": [
        "./src/ui/components/*.vue"
      ],
      "~/plugins/*": [
        "./src/ui/plugins/*"
      ],
      "~/utils/*": [
        "./src/utils/*"
      ],
      "@/*": [
        "./src/game/*"
      ],
      "@/models/*": [
        "./src/game/models/*"
      ],
      "@/store/*": [
        "./src/game/store/*"
      ],
      "@/utils/*": [
        "./src/utils/*"
      ]
    },
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
